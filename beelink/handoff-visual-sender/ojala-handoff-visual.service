[Unit]
Description=Ojala verified handoff visual snapshot sender
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ojala
Group=ojala
WorkingDirectory=/opt/ojala-handoff-visual-sender
EnvironmentFile=/etc/ojala-handoff-visual-sender.env
ExecStart=/usr/bin/python3 /opt/ojala-handoff-visual-sender/handoff_visual_sender.py --config /etc/ojala-handoff-visual-sender.json --queue /var/lib/ojala-handoff-visual-sender/queue.sqlite3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ojala-handoff-visual-sender
ReadOnlyPaths=/home/ojala/frigate/config/verified_snapshots/handoff
